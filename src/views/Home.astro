---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import ContactCta from '../components/ContactCta.astro';
import { SITE } from '../site';
import type { Lang } from '../i18n/ui';
import { localePath, t, tf } from '../i18n/utils';
import { getWorks } from '../lib/works';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const works = await getWorks(lang);
const featured = works.filter((w) => w.data.featured);
const others = works.filter((w) => !w.data.featured);
const counts = {
  live: works.filter((w) => w.data.status === 'live').length,
  developing: works.filter((w) => w.data.status === 'developing').length,
};
// ヒーローの右側に見せる代表作（公開中の作品を優先し、横長の画面を使う）
const showcase = works.find((w) => w.data.status === 'live') ?? works[0];
// カードの先頭の画面と重ならないよう、2枚目以降の横長の画面を優先する
const landscape = showcase?.data.screenshots.filter((s) => s.src.width > s.src.height) ?? [];
const showcaseShot = landscape[1] ?? landscape[0];
---

<Base lang={lang}>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <span class="blob b1"></span>
      <span class="blob b2"></span>
      <span class="blob b3"></span>
      <span class="grid-lines"></span>
    </div>
    <div class="container hero-inner">
      <div class="hero-text">
        <div class="who" data-reveal style="--d: 0s">
          <Image
            class="avatar"
            src={SITE.photo}
            alt={SITE.photoAlt[lang]}
            widths={[72, 144]}
            sizes="72px"
            loading="eager"
          />
          <div>
            <p class="eyebrow">{SITE.role[lang]}</p>
            <h1>{SITE.name[lang]}</h1>
          </div>
        </div>
        <p class="catch" data-reveal style="--d: 0.12s">{t(lang, 'home.catch')}</p>
        <p class="intro" data-reveal style="--d: 0.24s">{SITE.intro[lang]}</p>
        <ul class="chips">
          {
            [
              t(lang, 'home.chip.solo'),
              t(lang, 'home.chip.ai'),
              t(lang, 'home.chip.cost'),
              tf(lang, 'home.chip.status', counts),
            ].map((chip, i) => (
              <li data-reveal="zoom" style={`--d: ${0.36 + i * 0.07}s`}>
                {chip}
              </li>
            ))
          }
        </ul>
        <div class="cta" data-reveal style="--d: 0.66s">
          <a class="btn btn-primary" href="#projects">{t(lang, 'home.cta.works')}</a>
          <a class="btn btn-ghost" href={localePath(lang, '/contact/')}>{t(lang, 'home.cta.contact')}</a>
        </div>
      </div>
      {
        showcase && showcaseShot && (
          <a
            class="showcase"
            href={localePath(lang, `/projects/${showcase.slug}/`)}
            data-reveal="right"
            data-tilt="10"
            style="--d: 0.3s"
          >
            <span class="frame" aria-hidden="true">
              <span class="dots">
                <i />
                <i />
                <i />
              </span>
            </span>
            <Image
              src={showcaseShot.src}
              alt={showcaseShot.alt}
              widths={[480, 960]}
              sizes="480px"
              loading="eager"
            />
            <span class="caption">
              <span class="muted">{t(lang, 'home.showcase')}</span>
              <strong>{showcase.data.title} →</strong>
            </span>
          </a>
        )
      }
    </div>
  </section>

  <section id="projects" class="section" aria-labelledby="featured-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 id="featured-title">{featured.length > 0 ? t(lang, 'home.featured') : t(lang, 'home.all')}</h2>
      </div>
      <ul class="grid featured">
        {
          (featured.length > 0 ? featured : works).map((work, i) => (
            <li class:list={{ lead: i === 0 }} data-reveal style={`--d: ${i === 0 ? 0 : 0.08 * i}s`}>
              <WorkCard lang={lang} work={work} variant="featured" wide={i === 0} eager={i < 1} />
            </li>
          ))
        }
      </ul>

      {
        featured.length > 0 && others.length > 0 && (
          <>
            <div class="section-head others-head">
              <h2>{t(lang, 'home.all')}</h2>
            </div>
            <ul class="grid">
              {others.map((work) => (
                <li>
                  <WorkCard lang={lang} work={work} />
                </li>
              ))}
            </ul>
          </>
        )
      }

      <div class="closing" data-reveal>
        <ContactCta lang={lang} />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(56px, 10vw, 120px) clamp(24px, 4vw, 40px);
    background:
      radial-gradient(60% 80% at 100% 0%, color-mix(in srgb, var(--brand) 12%, transparent), transparent 70%),
      radial-gradient(40% 60% at 85% 10%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%);
  }
  /* 背景：ゆっくり動くオーロラと、うっすらした方眼 */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.55;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .b1 {
    width: 520px;
    height: 520px;
    top: -180px;
    right: -120px;
    background: color-mix(in srgb, var(--brand) 55%, transparent);
  }
  .b2 {
    width: 380px;
    height: 380px;
    top: 120px;
    right: 22%;
    background: color-mix(in srgb, #22c3ee 45%, transparent);
    animation-duration: 22s;
    animation-delay: -6s;
  }
  .b3 {
    width: 300px;
    height: 300px;
    bottom: -140px;
    left: -80px;
    background: color-mix(in srgb, var(--accent) 35%, transparent);
    animation-duration: 26s;
    animation-delay: -12s;
  }
  :global(html[data-theme='dark']) .blob {
    opacity: 0.35;
  }
  @keyframes drift {
    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-40px, 30px) scale(1.08);
    }
    100% {
      transform: translate(30px, -20px) scale(0.95);
    }
  }
  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--text) 6%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--text) 6%, transparent) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(70% 60% at 70% 30%, #000, transparent 75%);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 440px);
    align-items: center;
    gap: 40px 56px;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .avatar {
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 30%;
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--brand) 40%, transparent);
  }
  h1 {
    margin-top: 2px;
    font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.4rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .catch {
    margin-top: 24px;
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 1.1rem + 1.2vw, 2rem);
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: balance;
    background: linear-gradient(90deg, var(--brand-strong), var(--brand), #22c3ee, var(--brand-strong));
    background-size: 300% 100%;
    animation: shimmer 8s ease-in-out infinite;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @keyframes shimmer {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
  .intro {
    margin-top: 16px;
    max-width: 38em;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.1rem);
    color: var(--text-muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
  }
  .chips li {
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--brand) 25%, var(--border));
    background: color-mix(in srgb, var(--brand-soft) 60%, transparent);
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  /* 代表作の画面（ブラウザの枠つき） */
  .showcase {
    display: block;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg);
    overflow: hidden;
    box-shadow:
      0 24px 48px -12px color-mix(in srgb, var(--brand) 28%, transparent),
      var(--shadow);
    color: var(--text);
    text-decoration: none;
    transition: transform 0.2s;
  }
  /* カーソルに合わせて傾く（motion.ts が --rx / --ry を入れる）。表示の演出が終わってから効かせる */
  :global(html.js) .showcase.is-in {
    transform: perspective(1200px) rotateX(var(--rx, 2deg)) rotateY(var(--ry, -6deg));
    transition: transform 0.25s ease-out;
  }
  .frame {
    display: flex;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border);
  }
  .showcase img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  .caption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .showcase {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .avatar {
      width: 56px;
      height: 56px;
    }
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .grid.featured {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
  }
  @media (min-width: 820px) {
    .grid.featured {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .grid.featured .lead {
      grid-column: 1 / -1;
    }
  }
  .closing {
    margin-top: clamp(48px, 7vw, 80px);
  }
  .others-head {
    margin-top: 56px;
  }
</style>
