---
/* 案2「ターミナル」：コマンドが自動でタイプされ、自己紹介が出てくる */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import ContactCta from '../components/ContactCta.astro';
import { SITE } from '../site';
import type { Lang } from '../i18n/ui';
import { localePath, t, tf } from '../i18n/utils';
import { aggregateStack, getWorks } from '../lib/works';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const works = await getWorks(lang);
const featured = works.filter((w) => w.data.featured);
const others = works.filter((w) => !w.data.featured);
const counts = {
  live: works.filter((w) => w.data.status === 'live').length,
  developing: works.filter((w) => w.data.status === 'developing').length,
};
// ターミナルに打つ内容（コマンドと、その出力）
const ja = lang === 'ja';
// neofetch 風のプロフィール（丸い写真の横に並べる）
// プロジェクトでよく使う技術に、仕事などで使ってきた技術を足す
const EXTRA_STACK = ['Java', 'React', 'Flutter'];
const topStack = [
  ...new Set([
    ...aggregateStack(works)
      .flatMap((g) => g.items)
      .sort((a, b) => b.works.length - a.works.length)
      .slice(0, 4)
      .map((i) => i.name),
    ...EXTRA_STACK,
  ]),
];
const profile: [string, string | string[]][] = [
  ['Role', `${SITE.role[lang]}${ja ? '（5年）' : ' (5 yrs)'}`],
  ['Focus', ja ? '企画 → 設計 → 開発 → 公開 → 運用' : 'Plan → Design → Build → Ship → Run'],
  ['Stack', topStack],
  ['Status', tf(lang, 'home.chip.status', counts)],
  ['Hobby', ja ? 'バスケットボール 🏀' : 'Basketball 🏀'],
];
const lines: { cmd: string; out: string[]; fetch?: boolean }[] = [
  { cmd: 'whoami', out: [`${SITE.name[lang]} — ${SITE.role[lang]}`] },
  { cmd: 'neofetch', out: [], fetch: true },
  { cmd: 'cat mission.txt', out: [t(lang, 'home.catch')] },
  { cmd: 'ls projects/', out: [works.map((w) => w.slug).join('   ')] },
];
---

<Base lang={lang}>
  <section class="hero">
    <div class="container">
      {/* 読み上げと検索用の本文。見た目はターミナルが担う */}
      <h1 class="visually-hidden">{SITE.name[lang]} — {SITE.role[lang]}</h1>
      <p class="visually-hidden">{t(lang, 'home.catch')}</p>

      <div class="term" aria-hidden="true" data-reveal="zoom">
        <div class="bar">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="title">naohiro@naomaru.app: ~</span>
        </div>
        <div class="screen">
          {
            lines.map((l) => (
              <div class="block">
                <p class="cmd">
                  <span class="prompt">~ $</span> <span data-type>{l.cmd}</span>
                </p>
                {l.out.map((o) => (
                  <p class="out" data-out>
                    {o}
                  </p>
                ))}
                {l.fetch && (
                  <div class="out fetch">
                    <Image class="face" src={SITE.photo} alt="" widths={[112, 224]} sizes="112px" loading="eager" />
                    <dl>
                      <div class="host">
                        <dt>naohiro</dt>
                        <dd>@naomaru.app</dd>
                      </div>
                      {profile.map(([k, v]) => (
                        <div>
                          <dt>{k}:</dt>
                          <dd>
                            {Array.isArray(v)
                              ? v.map((item, i) => (
                                  <>
                                    {i > 0 && ' / '}
                                    <span class="nowrap">{item}</span>
                                  </>
                                ))
                              : v}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                )}
              </div>
            ))
          }
          <p class="cmd">
            <span class="prompt">~ $</span> <span class="caret"></span>
          </p>
        </div>
      </div>

      <p class="intro" data-reveal style="--d: 0.2s">{SITE.intro[lang]}</p>
      <div class="cta" data-reveal style="--d: 0.3s">
        <a class="btn btn-primary" href="#projects">{t(lang, 'home.cta.works')}</a>
        <a class="btn btn-ghost" href={localePath(lang, '/contact/')}>{t(lang, 'home.cta.contact')}</a>
      </div>
    </div>
  </section>

  <section id="projects" class="section" aria-labelledby="featured-title">
    <div class="container">
      <div class="section-head code" data-reveal>
        <h2 id="featured-title">{featured.length > 0 ? t(lang, 'home.featured') : t(lang, 'home.all')}</h2>
      </div>
      <ul class="grid featured">
        {
          (featured.length > 0 ? featured : works).map((work, i) => (
            <li class:list={{ lead: i === 0 }} data-reveal style={`--d: ${i === 0 ? 0 : 0.08 * i}s`}>
              <WorkCard lang={lang} work={work} variant="featured" wide={i === 0} eager={i < 1} />
            </li>
          ))
        }
      </ul>
      {
        featured.length > 0 && others.length > 0 && (
          <>
            <div class="section-head code others-head" data-reveal>
              <h2>{t(lang, 'home.all')}</h2>
            </div>
            <ul class="grid">
              {others.map((work) => (
                <li data-reveal>
                  <WorkCard lang={lang} work={work} />
                </li>
              ))}
            </ul>
          </>
        )
      }
      <div class="closing" data-reveal>
        <ContactCta lang={lang} />
      </div>
    </div>
  </section>
</Base>

<script>
  // コマンドも応答も1文字ずつ打つ。「視差効果を減らす」ときは最初から全部見せる
  const screen = document.querySelector<HTMLElement>('.term .screen');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (screen && !reduce) {
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const blocks = [...screen.querySelectorAll<HTMLElement>('.block')];
    const caretLine = screen.lastElementChild as HTMLElement;

    // 応答の中の文字（テキストノード）を、表示順に集めて空にしておく
    const collect = (root: Element) => {
      const nodes: { node: Text; text: string }[] = [];
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      for (let n = walker.nextNode(); n; n = walker.nextNode()) {
        const text = n.nodeValue ?? '';
        if (!text.trim()) continue;
        nodes.push({ node: n as Text, text });
        n.nodeValue = '';
      }
      return nodes;
    };
    const plan = blocks.map((block) => {
      const cmd = block.querySelector<HTMLElement>('[data-type]')!;
      const cmdText = cmd.textContent ?? '';
      cmd.textContent = '';
      const outs = [...block.querySelectorAll<HTMLElement>('.out')].map(collect);
      block.hidden = true;
      return { block, cmd, cmdText, outs: outs.flat() };
    });
    caretLine.hidden = true;

    // 1文字ずつ打つ。打っている要素にカーソルを付ける
    const type = async (node: Text, text: string, min: number, jitter: number) => {
      const el = node.parentElement!;
      el.classList.add('cursor');
      for (const ch of text) {
        node.nodeValue += ch;
        await sleep(min + Math.random() * jitter);
      }
      el.classList.remove('cursor');
    };

    (async () => {
      await sleep(500);
      for (const { block, cmd, cmdText, outs } of plan) {
        block.hidden = false;
        await type(cmd.firstChild as Text ?? cmd.appendChild(document.createTextNode('')), cmdText, 45, 60);
        await sleep(220);
        block.classList.add('responding');
        await sleep(block.querySelector('.fetch') ? 350 : 60);
        for (const { node, text } of outs) {
          await type(node, text, 14, 22);
          await sleep(40);
        }
        block.classList.add('done');
        await sleep(300);
      }
      caretLine.hidden = false;
    })();
  } else if (screen) {
    screen.querySelectorAll('.block').forEach((b) => b.classList.add('responding', 'done'));
  }
</script>

<style>
  .hero {
    padding-block: clamp(40px, 8vw, 96px) clamp(24px, 4vw, 40px);
    background:
      radial-gradient(60% 60% at 50% 0%, color-mix(in srgb, #22c55e 10%, transparent), transparent 70%),
      var(--bg);
  }
  .term {
    max-width: 860px;
    margin-inline: auto;
    border-radius: 14px;
    overflow: hidden;
    background: #0a0f1a;
    border: 1px solid #1f2a3d;
    box-shadow:
      0 30px 60px -20px rgb(0 0 0 / 0.45),
      0 0 0 1px rgb(34 197 94 / 0.08),
      0 0 60px -10px rgb(34 197 94 / 0.25);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: #111827;
    border-bottom: 1px solid #1f2a3d;
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ef4444;
  }
  .dots i:nth-child(2) {
    background: #f59e0b;
  }
  .dots i:nth-child(3) {
    background: #22c55e;
  }
  .title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #94a3b8;
  }
  .screen {
    position: relative;
    padding: 20px clamp(16px, 3vw, 28px) 24px;
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 0.8rem + 0.4vw, 1.05rem);
    line-height: 1.75;
    color: #e2e8f0;
  }
  /* うっすら走査線 */
  .screen::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 3px);
  }
  .cmd {
    color: #e2e8f0;
  }
  .prompt {
    color: #22c55e;
    font-weight: 700;
  }
  .out {
    color: #93c5fd;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.35s,
      transform 0.35s;
    word-break: break-all;
  }
  .block + .block,
  .block + .cmd {
    margin-top: 10px;
  }
  .block:nth-child(3) .out {
    color: #fde68a;
    font-weight: 700;
    font-size: 1.1em;
  }
  /* neofetch：丸い写真と、項目の一覧 */
  .fetch {
    display: flex;
    align-items: center;
    gap: clamp(14px, 3vw, 28px);
    margin-top: 8px;
    color: #e2e8f0;
  }
  .face {
    flex: none;
    width: clamp(76px, 18vw, 112px);
    height: clamp(76px, 18vw, 112px);
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 30%;
    border: 2px solid #22c55e;
    box-shadow:
      0 0 0 4px rgb(34 197 94 / 0.15),
      0 0 24px rgb(34 197 94 / 0.35);
  }
  .fetch dl {
    margin: 0;
    display: grid;
    gap: 1px;
    min-width: 0;
    font-size: 0.92em;
  }
  .fetch dl > div {
    display: flex;
    gap: 8px;
  }
  .fetch dt {
    flex: none;
    width: 5.4em;
    white-space: nowrap;
    color: #22c55e;
    font-weight: 700;
  }
  /* 技術名の途中では改行しない（区切りの「 / 」で折り返す） */
  .nowrap {
    white-space: nowrap;
  }
  .fetch dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* スマホでは写真を上、項目を下に並べる */
  @media (max-width: 520px) {
    .fetch {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .fetch .host dt {
    width: auto;
    color: #93c5fd;
  }
  .fetch .host dd {
    color: #93c5fd;
  }
  .responding .out {
    opacity: 1;
    transform: none;
  }
  .face {
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.4s,
      transform 0.5s cubic-bezier(0.2, 1.4, 0.4, 1);
  }
  .responding .face {
    opacity: 1;
    transform: none;
  }
  .cursor::after,
  .caret {
    content: '';
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    vertical-align: -0.2em;
    background: #22c55e;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .intro {
    max-width: 40em;
    margin: 32px auto 0;
    text-align: center;
    color: var(--text-muted);
  }
  .cta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  /* 見出しをコードのコメント風に */
  .code h2::before {
    content: '// ';
    font-family: var(--font-mono);
    color: #22c55e;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 820px) {
    .grid.featured {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .grid.featured .lead {
      grid-column: 1 / -1;
    }
  }
  .others-head {
    margin-top: 56px;
  }
  .closing {
    margin-top: clamp(48px, 7vw, 80px);
  }
</style>
