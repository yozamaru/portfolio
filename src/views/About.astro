---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import type { Lang } from '../i18n/ui';
import { localePath, t, tf, tl } from '../i18n/utils';
import { aggregateStack, getWorks } from '../lib/works';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const works = await getWorks(lang);
const stack = aggregateStack(works);

/** About の本文（下書き。本人の確認待ち） */
const principles = {
  ja: [
    {
      title: '企画から運用まで、一人でやり切る',
      body: '誰のどんな困りごとを解くのかを決めるところから、設計、実装、テスト、公開、運用までを一人で回しています。作って終わりにせず、動かし続けられる形にすることを大事にしています。',
    },
    {
      title: '信頼は仕組みで担保する',
      body: 'ひもとくAIでは採点を改ざんできない仕組みを、B.PREDICTでは試合開始後に予測を書き換えられない仕組みを、データベースの層で作りました。「気をつける」ではなく、構造として守ることを選びます。',
    },
    {
      title: '費用をかけずに続けられる構成',
      body: '個人のプロダクトを長く続けるために、運用費は0円を基本にしています。無料枠の制約を前提に、静的な配信やブラウザ内での実行など、構成そのものを工夫しています。',
    },
    {
      title: 'AIと統計を、使えるプロダクトに',
      body: '機械学習の教材や統計モデルによる予測など、AIや統計の仕組みを実際のサービスに落とし込むことに取り組んでいます。モデルの精度だけでなく、評価の方法や見せ方まで設計します。',
    },
  ],
  en: [
    {
      title: 'Owning the whole product',
      body: 'I handle everything myself, from deciding whose problem to solve to design, implementation, testing, launch, and operations. I care about building things that keep running, not just things that ship.',
    },
    {
      title: 'Trust enforced by design',
      body: 'In Himotoku AI, answers cannot be tampered with; in B.PREDICT, predictions cannot be changed after tip-off. Both guarantees live in the database layer. I prefer structural guarantees over "being careful".',
    },
    {
      title: 'Zero running cost',
      body: 'To keep personal products alive for the long run, I aim for zero running cost. I design around free-tier limits with static delivery and in-browser execution.',
    },
    {
      title: 'Turning AI and statistics into products',
      body: 'From a machine learning course to statistical game predictions, I turn AI and statistical methods into real services, designing not only the models but also how they are evaluated and presented.',
    },
  ],
} satisfies Record<Lang, { title: string; body: string }[]>;
---

<Base lang={lang} title={t(lang, 'about.title')}>
  <section class="section">
    <div class="container">
      <h1>{t(lang, 'about.title')}</h1>
      <div class="profile">
        <Image
          class="photo"
          src={SITE.photo}
          alt={SITE.photoAlt[lang]}
          widths={[240, 480]}
          sizes="(max-width: 640px) 60vw, 240px"
          loading="eager"
        />
        <div>
          <p class="name">{SITE.name[lang]}<span class="role">{SITE.role[lang]}</span></p>
          <p class="lead">{SITE.intro[lang]}</p>
          <p class="lead">{SITE.bio[lang]}</p>
        </div>
      </div>

      <ul class="principles">
        {
          principles[lang].map((p) => (
            <li>
              <h2>{p.title}</h2>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="facts">
        <section aria-labelledby="scope-title">
          <h2 id="scope-title">{t(lang, 'about.scope')}</h2>
          <ol class="steps">
            {tl(lang, 'about.scope.items').map((item) => <li>{item}</li>)}
          </ol>
        </section>
        <section aria-labelledby="strengths-title">
          <h2 id="strengths-title">{t(lang, 'about.strengths')}</h2>
          <ul class="checks">
            {tl(lang, 'about.strengths.items').map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section aria-labelledby="looking-title">
          <h2 id="looking-title">{t(lang, 'about.looking')}</h2>
          <p>{t(lang, 'about.looking.body')}</p>
          <div class="links">
            <a class="btn btn-primary" href={localePath(lang, '/contact/')}>{t(lang, 'cta.button')} →</a>
            <a class="btn btn-ghost" href={SITE.github} target="_blank" rel="me noopener">
              GitHub ↗<span class="visually-hidden">{t(lang, 'work.newTab')}</span>
            </a>
          </div>
        </section>
      </div>

      <div class="section-head stack-head">
        <h2>{t(lang, 'about.stack')}</h2>
      </div>
      <p class="muted note">{t(lang, 'about.stackNote')}</p>
      <div class="stack-groups">
        {
          stack.map((group) => (
            <section class="stack-group" aria-labelledby={`stack-${group.category}`}>
              <h3 id={`stack-${group.category}`}>{t(lang, `stackcat.${group.category}`)}</h3>
              <ul class="chips">
                {group.items.map((item) => (
                  <li class:list={{ multi: item.works.length > 1 }}>
                    {item.name}
                    {item.works.length > 1 && (
                      <span class="count" aria-hidden="true">
                        ×{item.works.length}
                      </span>
                    )}
                    <span class="visually-hidden">
                      {`, ${t(lang, 'about.usedIn')}: ${item.works.map((w) => w.data.title).join(', ')}`}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .profile {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 24px 40px;
    margin-top: 28px;
  }
  .profile > div {
    flex: 1 1 320px;
  }
  .photo {
    width: min(240px, 60vw);
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .name {
    font-size: 1.3rem;
    font-weight: 700;
  }
  .role {
    margin-left: 12px;
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--text-muted);
  }
  .lead {
    margin-top: 16px;
    max-width: 40em;
    font-size: 1.1rem;
    color: var(--text-muted);
  }
  .principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
  }
  @media (max-width: 720px) {
    .principles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .principles li {
    padding: 24px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .principles h2 {
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin-top: 56px;
  }
  @media (max-width: 900px) {
    .facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
  .facts h2 {
    font-size: 1.1rem;
    margin-bottom: 12px;
  }
  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }
  .steps li {
    counter-increment: step;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-strong);
    font-size: 0.88rem;
    font-weight: 600;
  }
  .steps li::before {
    content: counter(step) '. ';
    opacity: 0.6;
  }
  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .checks li {
    position: relative;
    padding-left: 1.5em;
  }
  .checks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--ok);
    font-weight: 700;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }
  .stack-head {
    margin-top: 64px;
    margin-bottom: 8px;
  }
  .note {
    font-size: 0.9rem;
    margin-bottom: 24px;
  }
  .stack-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }
  .stack-group {
    padding: 20px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .stack-group h3 {
    font-size: 0.95rem;
    margin-bottom: 12px;
    color: var(--text-muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: 0.85rem;
  }
  .chips li.multi {
    border-color: color-mix(in srgb, var(--brand) 40%, var(--border));
    background: var(--brand-soft);
    font-weight: 600;
  }
  .count {
    font-size: 0.75rem;
    color: var(--brand);
  }
</style>
