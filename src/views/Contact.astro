---
import Base from '../layouts/Base.astro';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
/** 未設定なら Cloudflare のテスト用キー（常に通る）を使う */
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
const messages = {
  sending: t(lang, 'contact.sending'),
  success: t(lang, 'contact.success'),
  error: t(lang, 'contact.error'),
  captcha: t(lang, 'contact.error.captcha'),
  invalid: t(lang, 'contact.error.invalid'),
};
---

<Base lang={lang} title={t(lang, 'contact.title')}>
  <section class="section">
    <div class="container narrow">
      <h1>{t(lang, 'contact.title')}</h1>
      <p class="lead">{t(lang, 'contact.lead')}</p>

      <form id="contact-form" method="post" action="/api/contact" data-messages={JSON.stringify(messages)} novalidate>
        <input type="hidden" name="lang" value={lang} />
        <div class="field">
          <label for="name">{t(lang, 'contact.name')} <span class="req">{t(lang, 'contact.required')}</span></label>
          <input id="name" name="name" type="text" autocomplete="name" required maxlength="100" />
        </div>
        <div class="field">
          <label for="email">{t(lang, 'contact.email')} <span class="req">{t(lang, 'contact.required')}</span></label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
        </div>
        <div class="field">
          <label for="message">{t(lang, 'contact.message')} <span class="req">{t(lang, 'contact.required')}</span></label>
          <textarea id="message" name="message" rows="8" required maxlength="5000"></textarea>
        </div>
        <!-- ボット避け：人には見えない欄。入力があれば送信しない -->
        <div class="hp" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="cf-turnstile" data-sitekey={siteKey} data-theme="auto" data-language={lang}></div>
        <button class="btn btn-primary" type="submit">{t(lang, 'contact.submit')}</button>
        <p class="status" role="status" aria-live="polite"></p>
        <noscript><p class="notice">{t(lang, 'contact.noscript')}</p></noscript>
      </form>
    </div>
  </section>
</Base>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    const status = form.querySelector<HTMLParagraphElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const msg = JSON.parse(form.dataset.messages ?? '{}') as Record<string, string>;

    const show = (text: string, kind: 'info' | 'ok' | 'error') => {
      status.textContent = text;
      status.dataset.kind = kind;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        show(msg.invalid!, 'error');
        return;
      }
      const data = new FormData(form);
      if (!data.get('cf-turnstile-response')) {
        show(msg.captcha!, 'error');
        return;
      }
      button.disabled = true;
      show(msg.sending!, 'info');
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        const body = (await res.json().catch(() => ({}))) as { error?: string };
        if (res.ok) {
          form.reset();
          show(msg.success!, 'ok');
        } else {
          show(body.error === 'captcha' ? msg.captcha! : body.error === 'invalid' ? msg.invalid! : msg.error!, 'error');
        }
      } catch {
        show(msg.error!, 'error');
      } finally {
        button.disabled = false;
        // トークンは1回しか使えないので、結果に関わらず作り直す
        (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
      }
    });
  }
</script>

<style>
  .narrow {
    max-width: calc(680px + var(--gutter) * 2);
  }
  .lead {
    margin-top: 16px;
    color: var(--text-muted);
  }
  form {
    display: grid;
    gap: 20px;
    margin-top: 32px;
  }
  .field {
    display: grid;
    gap: 6px;
  }
  label {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .req {
    margin-left: 6px;
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand);
    font-size: 0.72rem;
    font-weight: 700;
    vertical-align: 1px;
  }
  input,
  textarea {
    width: 100%;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 1px;
    border-color: var(--brand);
  }
  textarea {
    resize: vertical;
    min-height: 180px;
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .cf-turnstile {
    min-height: 65px;
  }
  button {
    justify-self: start;
    min-width: 160px;
  }
  button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .status:empty {
    display: none;
  }
  .status {
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .status[data-kind='ok'] {
    background: var(--ok-soft);
    color: var(--ok);
    font-weight: 700;
  }
  .status[data-kind='error'] {
    background: var(--warn-soft);
    color: var(--warn);
    font-weight: 700;
  }
</style>
