---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { t, tf } from '../i18n/utils';
import type { Work } from '../lib/works';

interface Props {
  lang: Lang;
  screenshots: Work['data']['screenshots'];
  label: string;
}

const { lang, screenshots, label } = Astro.props;
const total = screenshots.length;
---

<section class="gallery" aria-label={label} data-count-template={t(lang, 'work.gallery.count')}>
  <ul>
    {
      screenshots.map((s, i) => {
        const portrait = s.src.height > s.src.width;
        return (
          <li class:list={[{ portrait, lead: i === 0 }]}>
            {/* JavaScript が無いときは画像ファイルを直接開く。あるときは拡大表示（dialog）で開く */}
            <a href={s.src.src} data-index={i} data-full={s.src.src} data-alt={s.alt}>
              <Image
                src={s.src}
                alt={s.alt}
                widths={portrait ? [360, 720] : [640, 1280]}
                sizes={portrait ? '(max-width: 720px) 80vw, 320px' : '(max-width: 720px) 92vw, 720px'}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
              <span class="zoom" aria-hidden="true">⤢</span>
              <span class="visually-hidden">{t(lang, 'work.gallery.zoom')}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
  {
    total > 1 && (
      <p class="count" aria-hidden="true">
        {tf(lang, 'work.gallery.count', { n: 1, total })}
      </p>
    )
  }

  <dialog class="lightbox" aria-label={label}>
    <div class="lb-inner">
      <button type="button" class="lb-close" data-action="close">
        <span aria-hidden="true">×</span>
        <span class="visually-hidden">{t(lang, 'work.gallery.close')}</span>
      </button>
      <figure>
        <img alt="" />
        <figcaption></figcaption>
      </figure>
      {
        total > 1 && (
          <div class="lb-nav">
            <button type="button" data-action="prev" aria-label={t(lang, 'work.gallery.prev')}>
              ←
            </button>
            <span class="lb-count" aria-live="polite" />
            <button type="button" data-action="next" aria-label={t(lang, 'work.gallery.next')}>
              →
            </button>
          </div>
        )
      }
    </div>
  </dialog>
</section>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('.gallery')) {
    const list = gallery.querySelector('ul')!;
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    const template = gallery.dataset.countTemplate ?? '{n} / {total}';
    const format = (n: number) => template.replace('{n}', String(n)).replace('{total}', String(links.length));

    // 横スクロールの位置に合わせて「1 / 3」を更新する
    const count = gallery.querySelector<HTMLElement>('.count');
    if (count) {
      list.addEventListener(
        'scroll',
        () => {
          const left = list.getBoundingClientRect().left;
          let current = 0;
          links.forEach((a, i) => {
            if (a.getBoundingClientRect().left - left < a.offsetWidth / 2) current = i;
          });
          count.textContent = format(current + 1);
        },
        { passive: true },
      );
    }

    // 拡大表示
    const dialog = gallery.querySelector<HTMLDialogElement>('dialog');
    if (!dialog || typeof dialog.showModal !== 'function') continue;
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    const lbCount = dialog.querySelector<HTMLElement>('.lb-count');
    let index = 0;
    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const a = links[index]!;
      img.src = a.dataset.full!;
      img.alt = a.dataset.alt ?? '';
      caption.textContent = a.dataset.alt ?? '';
      if (lbCount) lbCount.textContent = format(index + 1);
    };
    links.forEach((a, i) =>
      a.addEventListener('click', (event) => {
        event.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const action = target.closest<HTMLElement>('[data-action]')?.dataset.action;
      if (action === 'close' || target === dialog) dialog.close();
      else if (action === 'prev') show(index - 1);
      else if (action === 'next') show(index + 1);
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
  }
</script>

<style>
  ul {
    display: flex;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 4px 4px 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  li {
    flex: none;
    scroll-snap-align: start;
    width: min(720px, 88vw);
  }
  li.portrait {
    width: min(320px, 72vw);
  }
  a {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    background: var(--surface);
    cursor: zoom-in;
  }
  img {
    width: 100%;
    height: auto;
  }
  li:not(.portrait) img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  li.portrait img {
    aspect-ratio: 9 / 16;
    object-fit: cover;
    object-position: top;
  }
  .zoom {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgb(8 13 28 / 0.65);
    color: #fff;
    font-size: 1.1rem;
    line-height: 1;
  }
  .count {
    margin-top: -4px;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-align: center;
  }

  .lightbox {
    width: min(1200px, 100vw);
    max-width: 100vw;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
  }
  .lightbox::backdrop {
    background: rgb(4 8 20 / 0.88);
  }
  .lb-inner {
    display: grid;
    gap: 12px;
    padding: 56px 16px 16px;
  }
  figure {
    margin: 0;
    display: grid;
    gap: 10px;
    justify-items: center;
  }
  figure img {
    width: auto;
    max-width: 100%;
    max-height: calc(100dvh - 180px);
    border-radius: var(--radius-sm);
  }
  figcaption {
    max-width: 60em;
    font-size: 0.9rem;
    line-height: 1.6;
    text-align: center;
    color: rgb(255 255 255 / 0.85);
  }
  .lightbox button {
    min-width: 44px;
    min-height: 44px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.3);
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    font: inherit;
    font-size: 1.2rem;
    cursor: pointer;
  }
  .lightbox button:hover {
    background: rgb(255 255 255 / 0.2);
  }
  .lb-close {
    position: fixed;
    top: 12px;
    right: 12px;
  }
  .lb-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    font-size: 0.9rem;
  }
</style>
