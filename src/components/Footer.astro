---
import { SITE } from '../site';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <p>© {year} {SITE.name[lang]}</p>
    <ul>
      <li><a href={SITE.github} rel="me">GitHub</a></li>
      <li><a href={SITE.repo}>{t(lang, 'footer.source')}</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    margin-top: 48px;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 28px;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: var(--text-muted);
  }
  a:hover {
    color: var(--text);
  }
</style>
