---
import { Image } from 'astro:assets';
import type { Work } from '../lib/works';

interface Props {
  work: Work;
  size: number;
  /** 画面の最初に見える位置なら true */
  eager?: boolean;
}

const { work, size, eager = false } = Astro.props;
---

<Image
  class="work-icon"
  src={work.data.icon}
  alt=""
  width={size}
  height={size}
  densities={[1, 2]}
  loading={eager ? 'eager' : 'lazy'}
  style={`--size:${size}px`}
/>

<style>
  .work-icon {
    width: var(--size);
    height: var(--size);
    flex: none;
    border-radius: 22%;
    box-shadow: var(--shadow);
  }
</style>
